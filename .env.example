# .env.local にコピーして値を入れてください（このファイルには値を書かない）。
# 設定後に `npm run check:apis` で接続を確認できます。

# 作品・聖地DB（ブラウザにも公開される読み取り専用キー）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 聖地マップの表示（任意。未設定なら OpenStreetMap を表示）
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# ここから下はサーバー専用
# 地点間の移動時間（Routes API）
GOOGLE_ROUTES_API_KEY=
# 寄り道の確認と、調査リストの地点の位置検索（Places API (New)）。空なら GOOGLE_ROUTES_API_KEY を使う
GOOGLE_PLACES_API_KEY=
# 寄り道探し（Googleマップ グラウンディング）とおすすめコースの選択
GEMINI_API_KEY=
# 任意：寄り道探しのモデル（既定 gemini-3.5-flash → 使えなければ gemini-2.5-flash）
GEMINI_DETOUR_MODEL=
# 任意：おすすめコース選択のモデル
GEMINI_MODEL=
